{
  "name": "libfurry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "e621 gallery for macOS",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && LIBFURRY_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "package:mac:local": "npm run package:mac && bash scripts/create-local-signing-identity.sh && node scripts/sign-local-mac.cjs",
    "sign:mac:local": "node scripts/sign-local-mac.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "framer-motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "local.e322.mac",
    "productName": "libfurry",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../third_party",
        "to": "licenses/third_party"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.photography",
      "icon": "assets/AppIcon.icns",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "dmg": {
      "title": "libfurry",
      "artifactName": "libfurry-macos-${arch}.${ext}",
      "background": "assets/dmg-background.tiff",
      "iconSize": 140,
      "iconTextSize": 12,
      "window": {
        "width": 654,
        "height": 444
      },
      "contents": [
        {
          "x": 197,
          "y": 195,
          "type": "file"
        },
        {
          "x": 473,
          "y": 195,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "libfurry-macos-${arch}.${ext}"
  }
}
